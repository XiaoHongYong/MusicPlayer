<?xml version="1.0" encoding='UTF-8'?>
<skin defmainwnd="MainWnd" mainwnds="MainWnd">
	<include Name="Styles.xml"/>

	<skinwnd Extends="GlassMainFrame" Name="MainWnd"
			MinWidth="660" MinHeight="450" Width="880" Height="520" Menu="MainWndMenu"
			CmdHandler="ch_common,ch_playlist" Script="main.js" TranslucencyAlpha="225"
			ContextMenu="MainContextMenu">

		<Container Name="Body" Rect="0,0,w,h">

			<!-- 左栏(固定 300 宽): 四张玻璃卡片垂直堆叠(整体垂直居中):
			     封面 -> 歌曲信息+评分 -> 音量 -> 播放控制 -->
			<Container Name="LeftPanel" Rect="0,0,h-187,h">

				<!-- 卡片 1: 封面 -->
				<Container Name="ArtCard" Rect="0,0,w,w">
					<Property Name="BgImage" Image="panel.png" HorzExtendPos="11,21" VertExtendPos="11,21" BlendPixMode="alpha_blend"/>
					<AlbumArt Name="AlbumArt" Rect="10,10,w-20,h-20" ID="ID_ALBUMART" Image="albumart-disc.png"/>
				</Container>

				<!-- 卡片 2: 歌曲信息 + 评分 -->
				<Container Name="InfoCard" Rect="0,w + 10,w,82">
					<Property Name="BgImage" Image="panel.png" HorzExtendPos="11,21" VertExtendPos="11,21" BlendPixMode="alpha_blend"/>
					<MediaInfoText Name="Title" Rect="14,8,w-28,22" FontName="Tahoma" FontHeight="17" FontBold="TRUE" TextColor="#2B2F3A" Text="" MediaInfoType="Title" AlignText="AT_CENTER | AT_VCENTER"/>
					<MediaInfoText Name="Artist - Album" Rect="14,32,w-28,16" FontName="Tahoma" FontHeight="12" FontBold="false" TextColor="#5B6372" Text="" MediaInfoType="Artist|Album" CombineWith=" - " AlignText="AT_CENTER | AT_VCENTER"/>
					<RateButton id="ID_RATE" Rect="w/2-50,52,100,20" Image="rating.png" ImageRect="0,0,40,20" />
				</Container>

				<!-- 卡片 3: 播放控制 -->
				<Container Name="ControlCard" Rect="0,w + 102,w,85">
					<Property Name="BgImage" Image="panel.png" HorzExtendPos="11,21" VertExtendPos="11,21" BlendPixMode="alpha_blend"/>
					<Image Name="VolumeIcon" Rect="14,8,18,18" Image="volume.png" />
					<Slider Name="Volume" ID="ID_VOLUME" Rect="40,9,w-50,15"/>
					<Button Rect="w/2-24-58,30,48,48" ID="ID_PREVIOUS" ImageMask="prev-next-mask.png" ImageMaskRect="0,0,48,48"
						Image="prev-next.png" ImageSize="48,48" ImagePos="0,0" ImageSelPos="0,96" ImageFocusPos="0,48" />
					<Button Rect="w/2-24,30,48,48" ID="ID_PLAYPAUSE" ImageMask="playpause.png" ImageMaskRect="0,0,48,48"
						S0_Image="playpause.png" S0_ImageSize="48,48" S0_ImagePos="0,0" S0_ImageSelPos="0,96" S0_ImageFocusPos="0,48"
						S1_Image="playpause.png" S1_ImageSize="48,48" S1_ImagePos="48,0" S1_ImageSelPos="48,96" S1_ImageFocusPos="48,48" />
					<Button Rect="w/2+24+10,30,48,48" ID="ID_NEXT" ImageMask="prev-next-mask.png" ImageMaskRect="48,0,48,48"
						Image="prev-next.png" ImageSize="48,48" ImagePos="48,0" ImageSelPos="48,96" ImageFocusPos="48,48" />
				</Container>
			</Container>

			<!-- 右栏: 玻璃面板(列表/歌词)；视图切换 Tab 在底部工具栏 -->
			<Container Name="RightPanel" Rect="h-187+10,0,w-(h-187+10),h">
				<Property Name="BgImage" Image="panel.png" HorzExtendPos="11,21" VertExtendPos="11,21" BlendPixMode="alpha_blend"/>

				<Container ID="CID_PLAYLIST" Name="PlaylistArea" Rect="0,0,w,h">
					<!-- 网页风格搜索框: 白胶囊(与编辑框白底融合) + 内置放大镜, 编辑框去边框 -->
					<Container Name="SearchBar" Rect="12,10,w-24,26">
						<Property Name="BgImage" Image="search-bg.png" HorzExtendPos="16,48" VertExtendPos="13,14" BlendPixMode="alpha_blend"/>
						<Image Name="Search" Rect="8,3,20,20" Image="search.png"/>
						<NormalEdit ID="CID_E_SEARCH_MUSIC" Text="" PlaceHolder="Search music" Rect="34,3,w-34-10,20" EnableBorder="false"/>
					</Container>

					<GlassPlaylist Rect="8,42,w-20,h-50" EnableHeader="false" EnableBorder="false" KeywordEdit="CID_E_SEARCH_MUSIC"/>
				</Container>

				<DecorativeContainer ID="CID_LYRICS" Name="LyricsArea" Rect="0,0,w,h" Visible="false">
					<LyricsShow Rect="4,6,w-16,h-12" SetSkinBg="true"
					  EnableToolbar="FALSE" EnableAutoResize="FALSE" />

					<Container ID="CID_LYR_TOOL_BAR" Rect="w-110,10,94,30" Visible="False">
						<Property Name="BgImage" Image="lyr-ctrl-bg.png" HorzExtendPos="8,22" BlendPixMode="alpha_blend"/>

						<Toolbar ID="ID_TB_LYR_SYNC" Rect="12,4,70,22" Image="fl_buttons.png" enablehover="TRUE"
								units_x="22" blank_x="-1" blank_cx="22" seperator_x="220" seperator_cx="14" ButtonSpacesCX="2"
								MarginX="0" MarginY="0" FullStatusImage="TRUE">
							<button ID="ID_OPEN_LRC" Left="5" />
							<button ID="ID_BACKWARD_LYRICS" Left="6" Continuous="TRUE"/>
							<button ID="ID_FORWARD_LYRICS" Left="7" Continuous="TRUE"/>
						</Toolbar>

						<Toolbar ID="ID_TB_LYR_TXT" Rect="12,4,50,22" Image="fl_buttons.png" enablehover="TRUE"
								units_x="22" blank_x="-1" blank_cx="22" seperator_x="220" seperator_cx="14" ButtonSpacesCX="1"
								Margin="8,1,0,0" MarginX="0" MarginY="0" FullStatusImage="TRUE">
							<button ID="ID_OPEN_LRC" Left="5" />
							<button ID="ID_LYR_EDITOR" Left="16"/>
						</Toolbar>
					</Container>
				</DecorativeContainer>
			</Container>
		</Container>

		<Animation ID="CID_AM_HIDE_LYR_TB" FadeOut="CID_LYR_TOOL_BAR"/>
		<Animation ID="CID_AM_SHOW_LYR_TB" FadeIn="CID_LYR_TOOL_BAR"/>

	</skinwnd>
</skin>
