<?xml version="1.0" encoding="UTF-8"?>
<styles>
  <include Name="StyleBase.xml"/>

  <style>
	<!-- 主窗口: 浅色毛玻璃。WindowImage=bg.png 已烘焙圆角/描边/标题条/底栏。 -->
	<Window ToolTipBgColor="#2B2F3A" ToolTipTextColor="#FFFFFF" ToolTipFontName="Verdana" ToolTipFontHeight="13"
		FontName="Verdana" FontHeight="13" TextColor="#2B2F3A" BgColor="#E8EAF5"
		EnableTranslucency="true" TranslucencyAlpha="255"
	/>

	<!-- Windows / Linux 标题栏；Mac 用 Caption.mac 覆盖同名样式 -->
	<Caption Extends="Container" Name="Caption bar" TranslucencyWithSkin="TRUE">
		<MenuBar Rect="13,11,w/2-20,20" Name="Menu"
			TranslucencyWithSkin="TRUE" FontName="Verdana"
			FontHeight="13" FontBold="false" TextColor="#3A4150"
			TextColorPressed="#1F6FE0"
			BgColorPressed="#DCE9FB" BgPressedAlpha="220"/>

		<Text ID="ID_CAPTION" Rect="w/2-46,11,92,20" CaptionText="true" FontName="Verdana" FontHeight="15" FontBold="false" TextColor="#3A4150" LeftMargin="0" AlignText="AT_LEFT | AT_VCENTER"/>
		<Toolbar ID="CID_TB_SYSBT" Rect="w-8-70,11,70,20" TranslucencyWithSkin="TRUE"
			Image="caption-btn-lg.png" enablehover="TRUE" units_x="20"
			blank_x="-1" blank_cx="20" seperator_x="0" seperator_cx="10"
			MarginX="0" MarginY="0" ButtonSpacesCX="5" FullStatusImage="TRUE">
			<button ID="ID_MINIMIZE" Left="1" />
			<button ID="ID_MAXIMIZE" Left="2" CanCheck="TRUE" checked_left="3"/>
			<button ID="ID_CLOSE" Left="4" />
		</Toolbar>
	</Caption>
	<Caption.mac Extends="Container" Name="Caption bar" TranslucencyWithSkin="TRUE">
		<Toolbar ID="CID_TB_SYSBT" Rect="12,12,64,16" TranslucencyWithSkin="TRUE"
			Image="caption-btn-mac.png" enablehover="TRUE" units_x="16"
			blank_x="-1" blank_cx="16" seperator_x="0" seperator_cx="10"
			MarginX="0" MarginY="0" ButtonSpacesCX="8" FullStatusImage="TRUE">
			<button ID="ID_CLOSE" Left="4" />
			<button ID="ID_MINIMIZE" Left="1" />
			<button ID="ID_MAXIMIZE" Left="2" CanCheck="TRUE" checked_left="3"/>
		</Toolbar>
		<Text ID="ID_CAPTION" Rect="80,11,w-160,20" CaptionText="true" FontName="Verdana" FontHeight="15" FontBold="false" TextColor="#3A4150" LeftMargin="0" AlignText="AT_CENTER | AT_VCENTER"/>
	</Caption.mac>

	<DialogCaption Extends="Container" Name="Caption bar" TranslucencyWithSkin="TRUE">
		<Text ID="ID_CAPTION" Rect="24,6,w-80,20" CaptionText="true" FontName="Verdana" FontHeight="15" FontBold="false" TextColor="#3A4150" LeftMargin="0" AlignText="AT_LEFT | AT_VCENTER"/>
		<Toolbar ID="CID_TB_SYSBT" Rect="w-8-16,9,16,16" TranslucencyWithSkin="TRUE"
			Image="caption-btn.png" enablehover="TRUE" units_x="16"
			blank_x="-1" blank_cx="16" seperator_x="0" seperator_cx="10"
			MarginX="0" MarginY="0" ButtonSpacesCX="5" FullStatusImage="TRUE">
		  <button ID="ID_CLOSE" Left="4" />
		</Toolbar>
	</DialogCaption>
	<DialogCaption.mac Extends="Container" Name="Caption bar" TranslucencyWithSkin="TRUE">
		<Toolbar ID="CID_TB_SYSBT" Rect="12,8,16,16" TranslucencyWithSkin="TRUE"
			Image="caption-btn-mac.png" enablehover="TRUE" units_x="16"
			blank_x="-1" blank_cx="16" seperator_x="0" seperator_cx="10"
			MarginX="0" MarginY="0" ButtonSpacesCX="8" FullStatusImage="TRUE">
		  <button ID="ID_CLOSE" Left="4" />
		</Toolbar>
		<Text ID="ID_CAPTION" Rect="40,6,w-80,20" CaptionText="true" FontName="Verdana" FontHeight="15" FontBold="false" TextColor="#3A4150" LeftMargin="0" AlignText="AT_CENTER | AT_VCENTER"/>
	</DialogCaption.mac>

	<MenuCaption Extends="Container" Name="Caption bar" TranslucencyWithSkin="TRUE">
		<MenuBar Rect="13,6,w/2-20,20" Name="Menu"
			TranslucencyWithSkin="TRUE" FontName="Verdana"
			FontHeight="13" FontBold="false" TextColor="#3A4150"
			TextColorPressed="#1F6FE0"
			BgColorPressed="#DCE9FB" BgPressedAlpha="220"/>
		<Text ID="ID_CAPTION" Rect="w/2,6,w/2-10-60-10,20" CaptionText="true" FontName="Verdana" FontHeight="15" FontBold="false" TextColor="#3A4150" LeftMargin="0" AlignText="AT_LEFT | AT_VCENTER"/>
		<Toolbar ID="CID_TB_SYSBT" Rect="w-8-60,9,60,16" TranslucencyWithSkin="TRUE"
			Image="caption-btn.png" enablehover="TRUE" units_x="16"
			blank_x="-1" blank_cx="16" seperator_x="0" seperator_cx="10"
			MarginX="0" MarginY="0" ButtonSpacesCX="5" FullStatusImage="TRUE">
			<button ID="ID_MINIMIZE" Left="1" />
			<button ID="ID_MAXIMIZE" Left="2" CanCheck="TRUE" checked_left="3"/>
			<button ID="ID_CLOSE" Left="4" />
		</Toolbar>
	</MenuCaption>
	<MenuCaption.mac Extends="Container" Name="Caption bar" TranslucencyWithSkin="TRUE">
		<Toolbar ID="CID_TB_SYSBT" Rect="12,8,64,16" TranslucencyWithSkin="TRUE"
			Image="caption-btn-mac.png" enablehover="TRUE" units_x="16"
			blank_x="-1" blank_cx="16" seperator_x="0" seperator_cx="10"
			MarginX="0" MarginY="0" ButtonSpacesCX="8" FullStatusImage="TRUE">
			<button ID="ID_CLOSE" Left="4" />
			<button ID="ID_MINIMIZE" Left="1" />
			<button ID="ID_MAXIMIZE" Left="2" CanCheck="TRUE" checked_left="3"/>
		</Toolbar>
		<Text ID="ID_CAPTION" Rect="80,6,w-160,20" CaptionText="true" FontName="Verdana" FontHeight="15" FontBold="false" TextColor="#3A4150" LeftMargin="0" AlignText="AT_CENTER | AT_VCENTER"/>
	</MenuCaption.mac>

	<GlassMainFrame Extends="Window"
		MinWidth="660" MinHeight="450" Width="880" Height="520">

		<Property Name="WindowImage" Image="bg.png" HorzExtendPos="11,53" VertExtendPos="43,63" />

		<Caption Rect="2,2,w-4,41"/>

		<ClientArea Rect="10,53,w-20,h-53-40" ClipChildren="true"/>

		<Container Name="BottomBar" Rect="0,h-30,w,30" TranslucencyWithSkin="TRUE">
			<PlayingTimeText Name="TimeElapsed" Rect="16,7,44,16" FontName="Verdana" FontHeight="12" TextColor="#5B6372" AlignText="AT_LEFT | AT_VCENTER"/>
			<Slider Name="Seek" ID="ID_SEEK" Rect="68,8,w-68-160,14"/>
			<MediaInfoText Name="Duration" Rect="w-150,7,44,16" FontName="Verdana" FontHeight="12" TextColor="#8A93A3" Text="" MediaInfoType="Duration" AlignText="AT_LEFT | AT_VCENTER"/>
			<!-- 播放列表 / 歌词切换放在右下角，进度条相应缩短 -->
			<Toolbar ID="CID_TB_VIEW" Rect="w-96,1,80,28" Image="view-tabs.png" enablehover="TRUE"
					units_x="40" blank_x="-1" blank_cx="40" seperator_x="0" seperator_cx="0"
					MarginX="0" MarginY="0" ButtonSpacesCX="0" FullStatusImage="TRUE">
				<button ID="CID_SHOW_PLAYLIST" Left="0" CanCheck="TRUE" checked_left="2" RadioGroup="1" Checked="TRUE" ToolTip="播放列表"/>
				<button ID="CID_SHOW_LYRICS" Left="1" CanCheck="TRUE" checked_left="3" RadioGroup="1" ToolTip="歌词"/>
			</Toolbar>
		</Container>
	</GlassMainFrame>

    <WindowFrame Extends="Window"
        MinWidth="100" MinHeight="100" Width="330" Height="400" IsDialog="true"
        BgColor="#E8EAF5">

		<Property Name="WindowImage" Image="bg-dialog.png" HorzExtendPos="11,53" VertExtendPos="33,51" />

		<DialogCaption Rect="2,2,w-4,31"/>

		<ClientArea Rect="10,33,w-20,h-33" ClipChildren="true"/>
	</WindowFrame>

    <MenuWindowFrame Extends="Window"
        MinWidth="100" MinHeight="100" Width="330" Height="400"
        BgColor="#E8EAF5">

		<Property Name="WindowImage" Image="bg-dialog.png" HorzExtendPos="11,53" VertExtendPos="33,51" />

		<MenuCaption Rect="2,2,w-4,31"/>

		<ClientArea Rect="6,33,w-12,h-33-6" ClipChildren="true"/>
    </MenuWindowFrame>

    <WndFrameCaption Extends="Text" ID="ID_CAPTION" Rect="30,4,w-60,20" Text="About DH Player" FontHeight="16" FontBold="true" TextColor="#2B2F3A" LeftMargin="0" AlignText="AT_CENTER | AT_VCENTER"/>

    <GlassPlaylist Extends="NormalPlaylist" StripeColor="#F0F4FA,#E8EEF6" SelBgColor="#4A9DFF"
        NowPlayingBgColor="#D9E9FF" NowPlayingTextColor="#1F6FE0" CustomizedColors="#2F7FE0,#8A93A3"
        TextColor="#3A4150" SelTextColor="#FFFFFF" FontName="Verdana" FontHeight="14" LineHeight="30"/>

	<MenuItemsContainer FontName="Verdana" FontHeight="13" FontBold="false" TextColor="#2B2F3A" BgColor="#FFFFFF"
		TextColorHover="#FFFFFF" BgColorHover="#4A9DFF" FrameColor="#C9D2E0" DisabledTextColor="#8A93A3" BgColorInactive="#F2F4F8"
		ImageChecked="menu-check.png" ImageSubmenu="menu-expand-right" ImageUpArrow="menu-expand-up" ImageDownArrow="menu-expand-down"/>

	<PopupWndFrame EnableTranslucency="true" TranslucencyAlpha="255"
		 FixedWidth="true" FixedHeight="true"
		 BgColor="#FFFFFF" EnableClickThrough="false">
		<XScaleImage Left="0" Top="0" Width="w" Height="5" Name="Top border"
			Image="menu-frame.png" ImageRect="0,0,50,5"
			ImageScaleXStart="10" ImageScaleXEnd="40" BlendPixMode="copy"/>
		<XScaleImage Left="0" Top="h-5" Width="w" Height="5" Name="Bottom border"
			Image="menu-frame.png" ImageRect="0,15,50,5"
			ImageScaleXStart="10" ImageScaleXEnd="40" BlendPixMode="copy"/>
		<Image Left="0" Top="5" Width="1" Height="h-10" Name="left frame"
			Image="menu-frame.png" ImageRect="0,5,1,10" BltMode="tile"/>
		<Image Left="w-1" Top="5" Width="1" Height="h-10" Name="left frame"
			Image="menu-frame.png" ImageRect="49,5,1,10" BltMode="tile"/>
		<ClientArea Rect="1, 5, w-2, h-5-5"/>
	</PopupWndFrame>

	<NormalListCtrl Extends="ListCtrl" StripeColor="#FFFFFF,#F0F4FA" SelBgColor="#4A9DFF"
		TextColor="#2B2F3A" SelTextColor="#FFFFFF"
		FontName="Verdana" FontHeight="13" LineHeight="22"
		HeaderHeight="22" LineColor="#C9D2E0"
		ImageHeader="listctrl-header.png"/>
  </style>
</styles>
